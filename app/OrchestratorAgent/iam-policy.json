        "arn:aws:bedrock-agentcore:us-east-1:740314716244:runtime/TripPlannerA2A_WeatherAgent-5pFZx8Ek8T",
        "arn:aws:bedrock-agentcore:us-east-1:740314716244:runtime/TripPlannerA2A_WeatherAgent-5pFZx8Ek8T/*"
      ]
    }
  ]
